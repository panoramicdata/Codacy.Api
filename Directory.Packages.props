<?xml version="1.0" encoding="utf-8"?>
<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <!-- Build / source-link tooling -->
        <PackageVersion Include="Nerdbank.GitVersioning" Version="3.10.94" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.400" />

        <!-- Runtime dependencies -->
        <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
        <PackageVersion Include="Refit" Version="15.2.0" />
        <PackageVersion Include="Refit.HttpClientFactory" Version="15.2.0" />

        <!-- Test dependencies -->
        <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
        <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
        <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.10.0" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Polly" Version="8.7.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.0" />
        <PackageVersion Include="Xunit.Microsoft.DependencyInjection" Version="10.1.0" />
    </ItemGroup>

</Project>
